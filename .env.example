# Copy to .env and fill in. Never commit .env.

# --- AI extraction (optional) ------------------------------------------------
# Free-tier Google Gemini API key: https://aistudio.google.com/apikey
# Leave empty to run entirely on the built-in rule-based extractor.
GEMINI_API_KEY=
# Model id — not hardcoded anywhere in the code, e.g. gemini-3.5-flash
GEMINI_MODEL=
# auto (Gemini when a key is present) | gemini | rules
EXTRACTOR=auto
AI_TIMEOUT_SECONDS=45

# --- Calendar output ---------------------------------------------------------
# Time used for a deadline that named a day but no hour
DEFAULT_DUE_TIME=09:00
ALARM_MINUTES_BEFORE=60
EVENT_DURATION_MINUTES=30

# --- Limits ------------------------------------------------------------------
MAX_CONVERSATION_CHARS=60000
MAX_UPLOAD_BYTES=1000000
